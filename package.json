{
  "name": "opendisk-manager",
  "productName": "OpenDisk Manager",
  "version": "1.0.0",
  "description": "Free, open-source Windows 11 disk partition and storage management director",
  "author": "OpenDisk Manager Contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "desktop-runner.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron desktop-runner.cjs",
    "desktop": "electron desktop-runner.cjs",
    "build:dir": "vite build && electron-builder --win --x64 --dir",
    "build:installer": "vite build && electron-builder --win nsis --x64",
    "build:portable": "vite build && electron-builder --win portable --x64",
    "build:all": "vite build && electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "io.opendiskmanager.app",
    "productName": "OpenDisk Manager",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "desktop-runner.cjs",
      "preload.cjs",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      "detect-disks.ps1",
      "resize-engine.ps1",
      "movement-engine.ps1",
      "advanced-engine.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenDisk Manager",
      "artifactName": "OpenDiskManager-Setup-${version}.${ext}",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "OpenDiskManager-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/cli": "^2.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.1"
  }
}
